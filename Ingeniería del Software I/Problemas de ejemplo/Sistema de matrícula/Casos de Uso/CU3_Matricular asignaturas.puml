@startuml MatricularAsignaturas
left to right direction
actor Estudiante

rectangle "Sistema de Matrículas" {

    usecase "Autenticarse en el sistema" as UC1
    usecase "Consultar oferta académica" as UC2
    usecase "Matricular asignaturas" as UC3
    usecase "Informar:\nsin cupos disponibles" as UC4
    usecase "Informar:\nmáximo 6 materias" as UC5

    ' Organización visual
    UC1 -[hidden]-> UC2
    UC2 -[hidden]-> UC3
    UC3 -[hidden]-> UC4
    UC4 -[hidden]-> UC5
}

Estudiante --> UC3
UC3 .> UC1 : <<include>>
UC3 .> UC2 : <<include>>
UC3 .> UC4 : <<extend>>
UC3 .> UC5 : <<extend>>
@enduml
