@startuml Clases Pokedex
skinparam classAttributeIconSize 0

package "App" {
  class App {
    -session_state : dict
    -search_results : list
    -search_term : str
    -selected_pokemon : dict
    -favorites : list
    -dark_mode : bool
    -current_view : str
    +initialize_session_state()
    +render_search_section()
    +render_results_section()
    +main()
  }
}

package "Controllers" {
  class PokemonController {
    +manejar_busqueda(termino_busqueda, filtro_tipo=None, generacion=None)
    +alternar_favorito(pokemon)
    +pokemon_aleatorio(filtro_tipo=None)
    +busqueda_avanzada(consulta, filtro_tipo=None, generacion=None)
    -validar_entrada_busqueda(termino_busqueda)
  }
  class ChartController {
    +crear_grafico_radar(pokemon)
  }
}

package "Models" {
  class PokemonModel {
    -JSON_SERVER_URL : str
    -POKEAPI_URL : str
    -CACHE_TTL : int
    +get_pokemon(identifier)
    +get_pokemon_from_json_server(identifier)
    +get_pokemon_from_pokeapi(identifier)
    +search_pokemon(query, type_filter, generation, min_stats, max_stats)
    +get_random_pokemon(type_filter=None)
    +get_all_pokemon_types()
  }
  class FavoritesModel {
    -FAVORITES_FILE : str
    +load_favorites()
    +save_favorites(favorites)
    +add_favorite(pokemon)
    +remove_favorite(pokemon_id)
    +is_favorite(pokemon_id)
  }
  class HistoryModel {
    -HISTORY_FILE : str
    +add_to_history(search_term, pokemon)
    +get_popular_pokemon(limit=5)
  }
}

package "Views" {
  class Layout {
    +setup_page_config()
    +load_css()
    +render_header()
    +render_footer()
  }
  class PokemonView {
    +render_pokemon_card(pokemon)
    +render_favorites_sidebar()
    +render_history_panel()
    +navigate_to_pokemon(identifier)
  }
}

package "Utils" {
  class Helpers {
    +normalize_search_term(term)
    +is_valid_pokemon_id(term)
    +load_json_file(path)
    +save_json_file(path, data)
    +retry_on_failure(function)
  }
  class Constants {
    +API_CONFIG : dict
    +POPULAR_POKEMON : list
    +TYPE_COLORS : dict
    +TYPE_ICONS : dict
  }
}

App --> Layout : uses
App --> PokemonView : uses
App --> PokemonController : calls
App --> ChartController : calls
App --> FavoritesModel : loads favorites
App --> HistoryModel : gets popular

PokemonController --> PokemonModel : uses
PokemonController --> FavoritesModel : uses
PokemonController --> HistoryModel : uses
PokemonController --> Helpers : uses
ChartController --> PokemonModel : uses
PokemonView --> FavoritesModel : uses
PokemonView --> PokemonController : calls

PokemonModel --> Constants : uses
Helpers --> Constants : uses

@enduml