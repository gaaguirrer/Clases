@startuml Secuencia Pokedex
actor Usuario
participant App
participant PokemonController
participant PokemonModel
participant FavoritesModel
participant HistoryModel
control API as "JSON Server / PokeAPI"

Usuario -> App : ingresa termino búsqueda
App -> PokemonController : manejar_busqueda(termino)
PokemonController -> PokemonModel : get_pokemon(termino)
PokemonModel -> API : request (JSON / PokeAPI)
API --> PokemonModel : datos_pokemon
PokemonModel --> PokemonController : pokemon
PokemonController -> HistoryModel : add_to_history(termino, pokemon)
HistoryModel --> PokemonController : ok
PokemonController --> App : mostrar_pokemon(pokemon)
App -> Usuario : renderizar tarjeta

Usuario -> App : clic favorito
App -> PokemonController : alternar_favorito(pokemon)
PokemonController -> FavoritesModel : is_favorite(id)
FavoritesModel --> PokemonController : false
PokemonController -> FavoritesModel : add_favorite(pokemon)
FavoritesModel --> PokemonController : ok
PokemonController --> App : estado_favorito_actualizado
App -> Usuario : actualizar icono favorito

@enduml
