# Variables de entorno para la aplicación Pokédex
# Copia este archivo como .env y ajusta según sea necesario

# URL del servidor JSON local
JSON_SERVER_URL=http://localhost:3000

# Puerto del servidor JSON
JSON_SERVER_PORT=3000

# URL de fallback a PokeAPI
POKEAPI_FALLBACK=https://pokeapi.co/api/v2

# Tiempo de vida del caché (segundos)
CACHE_TTL=3600

# Configuración de la aplicación
MAX_FAVORITES=50
MAX_HISTORY=20
RESULTS_PER_PAGE=20
