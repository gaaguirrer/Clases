div[data-testid="stButton"] button[kind="secondary"] {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-color);
}

/* Pokeball Logo (Pure CSS) */
.pokeball-logo {
    width: 40px;
    height: 40px;
    background: linear-gradient(to bottom, #ef4444 48%, #000 48%, #000 52%, #ffffff 52%);
    border-radius: 50%;
    border: 2px solid #000;
    position: relative;
    display: inline-block;
    vertical-align: middle;
    margin-right: 10px;
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
    animation: bounce 2s infinite ease-in-out;
    transition: transform 0.3s ease;
}

.pokeball-logo::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 12px;
    height: 12px;
    background: #fff;
    border: 2px solid #000;
    border-radius: 50%;
    z-index: 2;
    box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.5);
}

/* Hover animations */
.pokeball-logo:hover {
    animation: wobble 0.6s ease-in-out infinite;
    box-shadow: 0 0 15px rgba(239, 68, 68, 0.8);
}

.pokeball-logo:hover::before {
    animation: pulse-center 0.6s ease-in-out infinite;
}

@keyframes bounce {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-5px);
    }
}

@keyframes wobble {

    0%,
    100% {
        transform: rotate(0deg);
    }

    25% {
        transform: rotate(-8deg);
    }

    75% {
        transform: rotate(8deg);
    }
}

@keyframes pulse-center {

    0%,
    100% {
        background: #fff;
        box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.5);
    }

    50% {
        background: #ef4444;
        box-shadow: inset 0 0 5px rgba(255, 255, 255, 0.8), 0 0 10px rgba(239, 68, 68, 0.8);
    }
}