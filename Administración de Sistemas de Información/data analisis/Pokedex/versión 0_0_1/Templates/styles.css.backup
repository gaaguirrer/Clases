:root {
    --bg-color: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.7);
    --text-color: #f1f5f9;
    --accent-color: #38bdf8;
    --secondary-color: #f472b6;
    --stat-bg: rgba(255, 255, 255, 0.05);
    --stat-bar: linear-gradient(90deg, #38bdf8 0%, #818cf8 100%);
    --glass-border: 1px solid rgba(255, 255, 255, 0.1);
}

[data-theme="light"] {
    --bg-color: #f8fafc;
    --card-bg: rgba(255, 255, 255, 0.8);
    --text-color: #334155;
    --accent-color: #0ea5e9;
    --secondary-color: #d946ef;
    --stat-bg: rgba(0, 0, 0, 0.03);
    --glass-border: 1px solid rgba(0, 0, 0, 0.05);
}

.stApp {
    background-color: var(--bg-color);
    color: var(--text-color);
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

/* Sidebar Optimization - Maximize usable space without breaking collapse */
[data-testid="stSidebarUserContent"] {
    padding-top: 2rem;
    padding-left: 1rem;
    padding-right: 1rem;
}

[data-testid="stSidebar"] {
    background-color: var(--bg-color);
    border-right: var(--glass-border);
}

/* Glassmorphism Card Base */
.pokemon-card-compact {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: var(--glass-border);
    border-radius: 24px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    /* Enforce strict fixed height for symmetry */
    height: 600px !important;
    min-height: 600px !important;
    max-height: 600px !important;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
    /* Allow scroll if needed but keep shape */
}

/* Hide scrollbar for cleaner look */
.pokemon-card-compact::-webkit-scrollbar {
    display: none;
}

.pokemon-card-compact {
    -ms-overflow-style: none;
    scrollbar-width: none;
}

.pokemon-card-compact:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
}

/* Header */
.pokemon-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 1rem 0 2.5rem 0;
    /* More space below header */
}

.pokemon-name {
    font-size: 3.5rem;
    /* Larger title */
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent-color), var(--secondary-color));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0;
    letter-spacing: -1.5px;
    filter: drop-shadow(0 2px 10px rgba(var(--accent-color), 0.3));
}

.pokemon-id {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-color);
    padding: 0.5rem 1.2rem;
    border-radius: 16px;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 1px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
}

/* Image Container */
.pokemon-image-container-compact {
    position: relative;
    width: 300px;
    /* Slightly larger */
    height: 300px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: radial-gradient(circle, var(--stat-bg) 0%, transparent 70%);
    border-radius: 50%;
    margin: 0 auto;
}

.pokemon-image {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.3));
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.pokemon-image:hover {
    transform: scale(1.08) rotate(3deg);
}

/* Type Badges */
.type-badges {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.type-badge {
    padding: 0.6rem 2rem;
    border-radius: 50px;
    /* Pill shape */
    font-weight: 700;
    font-size: 1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.25);
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Stats */
.stats-container-compact {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    width: 100%;
    padding: 1rem 0;
}

.stat-item-compact {
    display: grid;
    grid-template-columns: 110px 45px 1fr;
    /* Label - Value - Bar */
    align-items: center;
    gap: 1.2rem;
}

.stat-label {
    font-size: 0.9rem;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 0.7;
    text-align: right;
    letter-spacing: 0.5px;
}

.stat-value {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--accent-color);
    text-align: center;
}

.stat-bar-container {
    height: 10px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.2);
}

.stat-bar {
    height: 100%;
    background: var(--stat-bar);
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.5);
}

/* Evolution Chain (Internal) */
.evolution-chain-internal {
    text-align: center;
    font-weight: 600;
    color: var(--text-color);
    opacity: 0.9;
    font-size: 1rem;
    padding-top: 1.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

/* Total Score */
.total-score {
    margin-top: 2rem;
    text-align: center;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

/* Tabs Styling - Transform stTabs into a Card */
div[data-testid="stTabs"] {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: var(--glass-border);
    border-radius: 24px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    padding: 2rem;
    /* Enforce strict fixed height for symmetry */
    height: 600px !important;
    min-height: 600px !important;
    max-height: 600px !important;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    /* Allow scroll if needed */
}

/* Hide scrollbar for cleaner look */
div[data-testid="stTabs"]::-webkit-scrollbar {
    display: none;
}

div[data-testid="stTabs"] {
    -ms-overflow-style: none;
    scrollbar-width: none;
}

.stTabs [data-baseweb="tab-list"] {
    gap: 1rem;
    justify-content: center;
    margin-bottom: 1.5rem;
    background: rgba(0, 0, 0, 0.2);
    padding: 0.5rem;
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.stTabs [data-baseweb="tab"] {
    height: 40px;
    white-space: pre-wrap;
    background-color: transparent;
    border-radius: 30px;
    padding: 0 2rem;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 600;
    transition: all 0.3s ease;
}

.stTabs [aria-selected="true"] {
    background-color: var(--accent-color);
    color: white;
    box-shadow: 0 4px 12px rgba(14, 165, 233, 0.4);
}

/* Responsive */
@media (max-width: 768px) {
    .pokemon-image-container-compact {
        width: 240px;
        height: 240px;
    }

    .stat-item-compact {
        grid-template-columns: 80px 35px 1fr;
        gap: 0.8rem;
    }

    .pokemon-name {
        font-size: 2rem;
    }

    /* Reset height for mobile */
    .pokemon-card-compact,
    div[data-testid="stTabs"] {
        height: auto !important;
        min-height: auto !important;
        max-height: none !important;
    }
}

/* Animations */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fillBar {
    from {
        width: 0;
    }
}

/* Custom Button Styling */
div[data-testid="stButton"] button[kind="primary"] {
    background-color: #0ea5e9;
    /* Blue */
    border-color: #0ea5e9;
    color: white;
    transition: all 0.3s ease;
}

div[data-testid="stButton"] button[kind="primary"]:hover {
    background-color: #0284c7;
    /* Darker Blue */
    border-color: #0284c7;
    box-shadow: 0 4px 12px rgba(14, 165, 233, 0.4);
}

